{
  "name": "stat3612-interactive-tutorials",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "python3 scripts/prepare_web.py",
    "dev": "npm run prepare:assets && vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run prepare:assets && npm run typecheck && vite build && node scripts/build_routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:web": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" index.html vite.config.ts tsconfig.json tests/browser playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "pyodide": "0.27.7",
    "three": "0.160.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.0"
  }
}
